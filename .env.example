# Copy to .env.local. Obtain a key at https://build.nvidia.com/ (Get API Key).
# Server only: never put this value in browser JavaScript or commit .env.local.
NVIDIA_API_KEY=replace_with_your_nvidia_api_key
# Optional: choose a hosted Nemotron model available to your NVIDIA account.
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# Server only: comma-separated exact frontend origins (no path or trailing slash).
# Needed when GitHub Pages calls a separate Vercel backend. No wildcard.
MONEYGUIDE_ALLOWED_ORIGINS=https://amos-isaya.github.io
# Public API URL is configured in js/config.js; this plain-JS project does not use Vite.
